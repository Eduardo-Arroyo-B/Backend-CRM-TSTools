// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  usuario  String  @unique
  password String?
  email    String  @unique
  activo   Boolean

  googleId String? @unique

  // Seguridad
  ultimo_login    DateTime?
  login_intentos  Int       @default(0)
  bloqueado_hasta DateTime?

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  // Relaciones
  Clientes  Clients[]
  Marcas    Brands[]
  Modelos   Models[]
  Ordenes   Orders[]
  Tecnicos  Technical[]
  Productos Products[]  @relation("ProductCreator")
  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  tenantId  String?     @db.Uuid
}

model Clients {
  id              Int        @id @default(autoincrement())
  nombre          String
  telefono        String
  segundoTelefono String?
  direccion       String
  tipo            clientType
  fechaCreacion   DateTime   @default(now())
  creador         String     @db.Uuid

  // Relaciones
  Usuario  User     @relation(fields: [creador], references: [id])
  Ordenes  Orders[]
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId String?  @db.Uuid
}

model Brands {
  id       Int      @id @default(autoincrement())
  marca    String
  usuario  String   @db.Uuid
  tenantId String?  @db.Uuid
  createAt DateTime @default(now())

  // Relaciones
  Usuario   User       @relation(fields: [usuario], references: [id])
  Modelos   Models[]
  Ordenes   Orders[]
  Servicios Services[]
  Productos Products[]
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])

  @@unique([marca, tenantId])
}

model Models {
  id        Int     @id @default(autoincrement())
  nombre    String
  usuarioId String  @db.Uuid
  tenantId  String? @db.Uuid
  brandId   Int

  // Relaciones
  Marca     Brands     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  Usuario   User       @relation(fields: [usuarioId], references: [id])
  Ordenes   Orders[]
  Servicios Services[]
  Productos Products[]
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])

  @@unique([brandId, nombre, tenantId])
}

model Orders {
  id Int @id @default(autoincrement())

  clienteId  Int
  marcaId    Int
  modeloId   Int
  servicioId Int

  atendio String @db.Uuid

  estado      estado
  estado_pago estadoPago

  total       Decimal @db.Decimal(12, 2)
  totalPagado Decimal @default(0) @db.Decimal(12, 2)
  descripcion String?

  // Imagenes
  imagenesObservaciones imagesObservations[]
  imagenesComentarios   imagesComments[]

  // DATOS EQUIPO
  imei       String?
  enciende   Boolean @default(true)
  bateria    Boolean @default(true)
  bandejaSim Boolean @default(true)
  golpes     Boolean @default(false)
  mojado     Boolean @default(false)

  // EXTRA
  contrasena    String?
  observaciones Observaciones[]
  comentarios   Comentarios[]
  tecnicoId     Int?

  // COMERCIAL
  garantia Int?

  // Validacion para seguimiento
  trackingToken String   @unique
  createAt      DateTime @default(now())
  updateAt      DateTime @updatedAt

  // Relaciones
  Clientes Clients    @relation(fields: [clienteId], references: [id])
  Usuario  User       @relation(fields: [atendio], references: [id])
  Marca    Brands     @relation(fields: [marcaId], references: [id])
  Modelo   Models     @relation(fields: [modeloId], references: [id])
  Servicio Services   @relation(fields: [servicioId], references: [id])
  Tecnico  Technical? @relation(fields: [tecnicoId], references: [id])
  tenant   Tenant?    @relation(fields: [tenantId], references: [id])
  tenantId String?    @db.Uuid

  @@index([tenantId, estado])
  @@index([tenantId, estado_pago])
  @@index([clienteId])
  @@index([tecnicoId])
}

model Services {
  id               Int      @id @default(autoincrement())
  tipo_servicio    Int
  equipoId         Int
  conceptoId       Int
  marcaId          Int
  modeloId         Int
  garantia         String
  precio_publico   Decimal  @db.Decimal(12, 2)
  precio_mayorista Decimal  @db.Decimal(12, 2)
  notas            String?
  proceso          String?
  fotoURL          String?
  fotoNotasURL     String?
  createAt         DateTime @default(now())
  updateAt         DateTime @updatedAt
  activo           Boolean  @default(true)

  // Relaciones
  Marca        Brands       @relation(fields: [marcaId], references: [id])
  Modelo       Models       @relation(fields: [modeloId], references: [id])
  Equipo       Devices      @relation(fields: [equipoId], references: [id])
  Concepto     Concept      @relation(fields: [conceptoId], references: [id])
  TipoServicio ServiceTypes @relation(fields: [tipo_servicio], references: [id])
  Ordenes      Orders[]
  tenant       Tenant?      @relation(fields: [tenantId], references: [id])
  tenantId     String?      @db.Uuid

  @@unique([tenantId, tipo_servicio, equipoId, conceptoId, marcaId, modeloId])
  @@index([tenantId, activo])
}

model Products {
  id               Int      @id @default(autoincrement())
  nombre           String
  sku              String
  descripcion      String?
  categoria        String?
  costo            Decimal  @default(0) @db.Decimal(12, 2)
  precio_publico   Decimal  @db.Decimal(12, 2)
  precio_mayorista Decimal? @db.Decimal(12, 2)
  stock            Int      @default(0)
  stockMinimo      Int      @default(0)
  activo           Boolean  @default(true)
  imagenURL        String?
  marcaId          Int?
  modeloId         Int?
  creadorId        String   @db.Uuid
  createAt         DateTime @default(now())
  updateAt         DateTime @updatedAt

  Marca   Brands? @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  Modelo  Models? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  Creador User    @relation("ProductCreator", fields: [creadorId], references: [id])

  @@unique([sku])
  @@index([activo])
  @@index([categoria])
  @@index([marcaId])
  @@index([modeloId])
}

/// Servicios ofrecidos globalmente por la empresa en el marketplace.
/// No pertenecen a un tenant: todos los usuarios pueden consultarlos.
model GlobalService {
  id              Int      @id @default(autoincrement())
  titulo          String
  precio          Decimal  @db.Decimal(10, 2)
  tiempoProceso   String
  descripcion     String   @db.Text
  incluye         String[]
  compatibilidad  String[]
  requisitos      String[] @default([])
  createAt        DateTime @default(now())
  updateAt        DateTime @updatedAt

  @@map("services_global")
}

model Devices {
  id     Int    @id @default(autoincrement())
  nombre String

  // Relaciones
  Servicios Services[]
}

model imagesObservations {
  id       Int      @id @default(autoincrement())
  ordenId  Int
  imageURL String
  createAt DateTime @default(now())

  // Relaciones
  orders Orders @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model imagesComments {
  id       Int      @id @default(autoincrement())
  ordenId  Int
  imageURL String
  createAt DateTime @default(now())

  // Relaciones
  orders Orders @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model ServiceTypes {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String
  activo      Boolean

  // Relaciones
  Servicios Services[]
  Conceptos Concept[]
}

model Concept {
  id            Int    @id @default(autoincrement())
  serviceTypeId Int
  nombre        String

  // Relaciones
  Servicios      Services[]
  TiposServicios ServiceTypes @relation(fields: [serviceTypeId], references: [id])
}

model Observaciones {
  id          Int      @id @default(autoincrement())
  ordenId     Int
  observacion String
  createAt    DateTime @default(now())

  // Relaciones
  orders Orders @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Comentarios {
  id         Int      @id @default(autoincrement())
  ordenId    Int
  comentario String
  createAt   DateTime @default(now())

  // Relaciones
  orders Orders @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Technical {
  id        Int     @id @default(autoincrement())
  nombre    String
  usuarioId String  @db.Uuid
  tenantId  String? @db.Uuid

  // Relaciones
  Ordenes  Orders[]
  Usuarios User     @relation(fields: [usuarioId], references: [id])
  Tenant   Tenant?  @relation(fields: [tenantId], references: [id])
}

model Tenant {
  id      String  @id @default(uuid()) @db.Uuid
  nombre  String
  logoURL String?

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  usuarios  User[]
  clientes  Clients[]
  marcas    Brands[]
  modelos   Models[]
  ordenes   Orders[]
  servicios Services[]
  tecnicos  Technical[]
}

enum estado {
  PENDIENTE
  ENPROCESO
  REPARADO
}

enum estadoPago {
  PENDIENTE
  DEBE
  PAGADO
  SINCOSTO
}

enum clientType {
  PUBLICO
  LOCATARIO
  MAYORISTA
  EMPRESA
}
